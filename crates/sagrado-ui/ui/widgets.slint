        columns: ["Column 1", "Column 2"];
        rows: ["an item", "an item", "an item"];
        secondary: ["123K", "123K", "123K"];
    }
    ThemedButton {
        label: "Button";
        x: 246px;
        y: 66px;
        width: 112px;
        height: 22px;
    }
    ThemedButton {
        label: "Disabled";
        disabled: true;
        x: 246px;
