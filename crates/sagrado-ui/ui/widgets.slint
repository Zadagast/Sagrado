import { VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";

export global ThemeRuntime {
    in-out property <int> revision;
    pure callback render(string, int, int, int, int) -> image;
    pure callback color(string, int) -> color;
}

component ThemedSurface inherits Rectangle {
    in property <string> slot: "box";
    in property <int> state;
    background: transparent;
    Image {
        preferred-width: 0px;
        preferred-height: 0px;
        source: ThemeRuntime.render(root.slot, root.width / 1px, root.height / 1px, root.state, ThemeRuntime.revision);
        image-fit: fill;
        width: parent.width;
        height: parent.height;
    }
}

component ThemedButton inherits ThemedSurface {
    in property <string> label;
    in property <bool> disabled;
    callback clicked();
    state: disabled ? 2 : touch.pressed || touch.has-hover ? 1 : 0;
    Text {
        text: root.label;
        color: ThemeRuntime.color("text", ThemeRuntime.revision);
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 4px;
        width: parent.width - 8px;
        y: 2px;
        height: parent.height - 4px;
    }
    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

component DefaultButton inherits ThemedButton {
    slot: "default_button";
}

component TickButton inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> disabled;
    property <int> visual-state: disabled ? 2 : touch.pressed || touch.has-hover ? 1 : 0;
    callback toggled(bool);
    background: transparent;
    box := ThemedSurface {
        slot: root.checked ? "tick_ticked" : "tick_blank";
        state: root.visual-state;
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
    }
    Text {
        text: root.label;
        color: ThemeRuntime.color("text", ThemeRuntime.revision);
        vertical-alignment: center;
        x: 26px;
        width: parent.width - 30px;
        height: parent.height;
    }
    touch := TouchArea {
        enabled: !root.disabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component MutexButton inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> disabled;
    property <int> visual-state: disabled ? 2 : touch.pressed || touch.has-hover ? 1 : 0;
    callback toggled(bool);
    background: transparent;
    box := ThemedSurface {
        slot: root.checked ? "mutex_ticked" : "mutex_blank";
        state: root.visual-state;
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
    }
    Text {
        text: root.label;
        color: ThemeRuntime.color("text", ThemeRuntime.revision);
        vertical-alignment: center;
        x: 26px;
        width: parent.width - 30px;
        height: parent.height;
    }
    touch := TouchArea {
        enabled: !root.disabled;
        clicked => {
            root.checked = true;
            root.toggled(true);
        }
    }
}

component PopupButton inherits ThemedButton {
    slot: "popup_button";
    callback opened();
    clicked => { root.opened(); }
}

component ThemedTextBox inherits ThemedSurface {
    in property <string> text;
    in property <bool> disabled;
    in property <bool> focused;
    callback edited(string);
    slot: "text_box";
    state: disabled ? 2 : focused ? 3 : 0;
    focused: input.has-focus;
    input := TextInput {
        text: root.text;
        color: ThemeRuntime.color("text", ThemeRuntime.revision);
        x: 5px;
        width: parent.width - 10px;
        y: 2px;
        height: parent.height - 4px;
        enabled: !root.disabled;
        edited => { root.edited(self.text); }
    }
}

component ColumnHeader inherits ThemedButton {
    slot: "column_header";
}

component ThemedList inherits Rectangle {
    in property <[string]> columns;
    in property <[string]> rows;
    in property <[string]> secondary;
    property <length> header-height: 18px;
    callback row-clicked(int);
    background: transparent;
    clip: true;
    HorizontalBox {
        x: 0px;
        y: 0px;
        padding: 0px;
        spacing: 0px;
        width: parent.width;
        height: root.header-height;
        for column in root.columns : ColumnHeader {
            label: column;
            width: parent.width / root.columns.length;
            height: parent.height;
            clicked => { }
        }
    }
    ListView {
        x: 0px;
        y: root.header-height;
        width: parent.width;
        height: parent.height - root.header-height;
        for row[index] in root.rows : Rectangle {
            width: parent.width;
            height: 18px;
            background: Math.mod(index, 2) == 0
                ? ThemeRuntime.color("text-box-background", ThemeRuntime.revision)
                : ThemeRuntime.color("primary-background", ThemeRuntime.revision);
            Text {
                text: row;
                color: ThemeRuntime.color("text", ThemeRuntime.revision);
                x: 6px;
                vertical-alignment: center;
                width: parent.width / 2 - 6px;
                height: parent.height;
            }
            Text {
                text: root.secondary[index];
                color: ThemeRuntime.color("text", ThemeRuntime.revision);
                x: parent.width / 2 + 6px;
                vertical-alignment: center;
                width: parent.width / 2 - 6px;
                height: parent.height;
            }
            TouchArea {
                clicked => { root.row-clicked(index); }
            }
        }
    }
}

component HorizontalSlider inherits ThemedSurface {
    in-out property <float> value;
    in property <bool> disabled;
    callback changed(float);
    slot: "h_slider_bar";
    state: disabled ? 2 : touch.pressed || touch.has-hover ? 1 : 0;
    ThemedSurface {
        slot: "h_slider_indicator";
        width: 14px;
        height: parent.height;
        x: (parent.width - self.width) * root.value;
        state: root.disabled ? 2 : 0;
    }
    touch := TouchArea {
        enabled: !root.disabled;
        clicked => {
            root.value = clamp(0.0, touch.mouse-x / root.width, 1.0);
            root.changed(root.value);
        }
    }
}

component ProgressBar inherits ThemedSurface {
    in property <float> value;
    slot: "progress_bar";
    ThemedSurface {
        slot: "progress_fill";
        width: parent.width * clamp(0.0, root.value, 1.0);
        height: parent.height;
    }
}

component HorizontalScrollBar inherits Rectangle {
    in-out property <float> value;
    in property <bool> disabled;
    callback changed(float);
    background: transparent;
    ThemedSurface {
        slot: "h_scrollbar_track";
        x: 18px;
        width: parent.width - 36px;
        height: parent.height;
    }
    ThemedSurface {
        slot: "h_scrollbar_thumb";
        x: 18px + (parent.width - 36px - self.width) * root.value;
        y: 0px;
        width: 32px;
        height: parent.height;
    }
    Rectangle {
        width: 18px;
        height: parent.height;
        background: transparent;
        Text {
            text: "◀";
            color: ThemeRuntime.color("text", ThemeRuntime.revision);
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        TouchArea {
            enabled: !root.disabled;
            clicked => {
                root.value = clamp(0.0, root.value - 0.1, 1.0);
                root.changed(root.value);
            }
        }
    }
    Rectangle {
        x: parent.width - 18px;
        width: 18px;
        height: parent.height;
        background: transparent;
        Text {
            text: "▶";
            color: ThemeRuntime.color("text", ThemeRuntime.revision);
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        TouchArea {
            enabled: !root.disabled;
            clicked => {
                root.value = clamp(0.0, root.value + 0.1, 1.0);
                root.changed(root.value);
            }
        }
    }
    TouchArea {
        enabled: !root.disabled;
        clicked => {
            root.value = clamp(0.0, (self.mouse-x - 18px) / (root.width - 36px), 1.0);
            root.changed(root.value);
        }
        moved => {
            if (self.pressed) {
                root.value = clamp(0.0, (self.mouse-x - 18px) / (root.width - 36px), 1.0);
                root.changed(root.value);
            }
        }
    }
}

component VerticalScrollBar inherits Rectangle {
    in-out property <float> value;
    in property <bool> disabled;
    callback changed(float);
    background: transparent;
    ThemedSurface {
        slot: "v_scrollbar_track";
        y: 18px;
        width: parent.width;
        height: parent.height - 36px;
    }
    ThemedSurface {
        slot: "v_scrollbar_thumb";
        x: 0px;
        y: 18px + (parent.height - 36px - self.height) * root.value;
        width: parent.width;
        height: 32px;
    }
    Rectangle {
        width: parent.width;
        height: 18px;
        background: transparent;
        Text {
            text: "▲";
            color: ThemeRuntime.color("text", ThemeRuntime.revision);
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        TouchArea {
            enabled: !root.disabled;
            clicked => {
                root.value = clamp(0.0, root.value - 0.1, 1.0);
                root.changed(root.value);
            }
        }
    }
    Rectangle {
        y: parent.height - 18px;
        width: parent.width;
        height: 18px;
        background: transparent;
        Text {
            text: "▼";
            color: ThemeRuntime.color("text", ThemeRuntime.revision);
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        TouchArea {
            enabled: !root.disabled;
            clicked => {
                root.value = clamp(0.0, root.value + 0.1, 1.0);
                root.changed(root.value);
            }
        }
    }
    TouchArea {
        enabled: !root.disabled;
        clicked => {
            root.value = clamp(0.0, (self.mouse-y - 18px) / (root.height - 36px), 1.0);
            root.changed(root.value);
        }
        moved => {
            if (self.pressed) {
                root.value = clamp(0.0, (self.mouse-y - 18px) / (root.height - 36px), 1.0);
                root.changed(root.value);
            }
        }
    }
}

component KdxList inherits Rectangle {
    in property <[string]> columns;
    in property <[string]> rows;
    in property <[string]> secondary;
    // Sunken frame border to inset content inside; scrollbar strip width.
    property <length> border: 3px;
    property <length> strip: 16px;
    callback row-clicked(int);
    background: transparent;
    Image {
        preferred-width: 0px;
        preferred-height: 0px;
        source: ThemeRuntime.render("box", root.width / 1px, root.height / 1px, 0, ThemeRuntime.revision);
        image-fit: fill;
        width: parent.width;
        height: parent.height;
    }
    ThemedList {
        columns: root.columns;
        rows: root.rows;
        secondary: root.secondary;
        x: root.border;
        y: root.border;
        width: parent.width - 2 * root.border - root.strip;
        height: parent.height - 2 * root.border - root.strip;
        row-clicked(index) => { root.row-clicked(index); }
    }
    VerticalScrollBar {
        x: parent.width - root.border - root.strip;
        y: root.border;
        width: root.strip;
        height: parent.height - 2 * root.border - root.strip;
        value: 0.0;
    }
    HorizontalScrollBar {
        x: root.border;
        y: parent.height - root.border - root.strip;
        width: parent.width - 2 * root.border - root.strip;
        height: root.strip;
        value: 0.0;
    }
}

component HorizontalSeparator inherits Rectangle {
    height: 2px;
    Image {
        preferred-width: 0px;
        preferred-height: 0px;
        source: ThemeRuntime.render("horiz_separator", root.width / 1px, root.height / 1px, 0, ThemeRuntime.revision);
        image-fit: fill;
        width: parent.width;
        height: parent.height;
    }
}

component VerticalSeparator inherits Rectangle {
    width: 2px;
    Image {
        preferred-width: 0px;
        preferred-height: 0px;
        source: ThemeRuntime.render("vert_separator", root.width / 1px, root.height / 1px, 0, ThemeRuntime.revision);
        image-fit: fill;
        width: parent.width;
        height: parent.height;
    }
}

component GroupBox inherits ThemedSurface {
    in property <string> title;
    in property <string> content;
    slot: "box";
    Text {
        text: root.title;
        color: ThemeRuntime.color("text", ThemeRuntime.revision);
        x: 12px;
        y: 0px;
    }
    Text {
        text: root.content;
        color: ThemeRuntime.color("text", ThemeRuntime.revision);
        x: 12px;
        y: 24px;
    }
}

component ThemePicker inherits Rectangle {
    in property <[string]> options;
    in-out property <string> selected;
    in property <string> caption;
    callback changed(string);
    height: 24px;
    ThemedButton {
        label: root.caption == "" ? root.selected : root.caption;
        width: parent.width;
        height: parent.height;
        clicked => { popup.visible = !popup.visible; }
    }
    popup := Rectangle {
        visible: false;
        y: 50px;
        width: parent.width;
        height: root.options.length * 24px;
        Image {
            preferred-width: 0px;
            preferred-height: 0px;
            source: ThemeRuntime.render("menu_background", self.width / 1px, self.height / 1px, 0, ThemeRuntime.revision);
            image-fit: fill;
            width: parent.width;
            height: parent.height;
        }
        for option[index] in root.options : ThemedButton {
            label: option;
            width: parent.width;
            height: 24px;
            y: index * 24px;
            clicked => {
                root.selected = option;
                root.changed(option);
                popup.visible = false;
            }
        }
    }
}

export component PreviewGallery inherits Window {
    title: "Preview GUI Items";
    width: 375px;
    height: 330px;
    in property <[string]> theme-options;
    in-out property <string> selected-theme;
    callback theme-changed(string);
    Image {
        preferred-width: 0px;
        preferred-height: 0px;
        source: ThemeRuntime.render("window_frame", self.width / 1px, self.height / 1px, 0, ThemeRuntime.revision);
        image-fit: fill;
        width: parent.width;
        height: parent.height;
    }
    ThemePicker {
        x: 8px;
        y: 8px;
        options: root.theme-options;
        selected: root.selected-theme;
        caption: "Miscellaneous";
        width: 178px;
        changed => { root.theme-changed(self.selected); }
